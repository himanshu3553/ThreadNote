{
  "name": "threadnote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --watch --import tsx/esm src/index.ts",
    "start": "node --env-file=.env --import tsx/esm src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "eval": "node --env-file=.env --import tsx/esm tests/eval.ts",
    "capture": "node --env-file=.env --import tsx/esm tests/capture-thread.ts",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@slack/bolt": "^4.0.0",
    "dotenv": "^16.4.5",
    "node-cron": "^4.2.1",
    "openai": "^4.70.0",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
